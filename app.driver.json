{
  "expo": {
    "name": "T Driver",
    "slug": "trav-ride",
    "owner": "travoney_1",
    "version": "6.6.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-driver.png",
    "scheme": "travony-driver",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "appVariant": "driver",
      "eas": {
        "projectId": "366f0f57-2f25-4053-a69b-1905365f8013"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.travony.driver",
      "infoPlist": {
        "NSCameraUsageDescription": "T Driver uses your camera to stream your ride live inside the app and to verify your vehicle with photos.",
        "NSMicrophoneUsageDescription": "T Driver uses your microphone so viewers can hear you while you stream your ride live."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1A1A1A",
        "foregroundImage": "./assets/images/android-icon-driver-foreground.png",
        "backgroundImage": "./assets/images/android-icon-driver-background.png",
        "monochromeImage": "./assets/images/android-icon-driver-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.travony.driver",
      "versionCode": 89,
      "config": {
        "googleMaps": {
          "apiKey": "${GOOGLE_API_KEY}"
        }
      },
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon-driver.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-driver.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A1A1A",
          "dark": {
            "backgroundColor": "#1A1A1A"
          }
        }
      ],
      "expo-web-browser",
      "./plugins/withAgoraPickFirst"
    ],
    "experiments": {
      "reactCompiler": false
    }
  }
}
