{
  "expo": {
    "name": "Travony",
    "slug": "trav-ride",
    "owner": "travoney_1",
    "version": "6.6.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "travony",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.travony.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Travony uses your camera to stream your ride live inside the app and to verify your vehicle with photos.",
        "NSMicrophoneUsageDescription": "Travony uses your microphone so viewers can hear you while you stream your ride live."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#00B14F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.travony.app",
      "versionCode": 94,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "travony" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "config": {
        "googleMaps": {
          "apiKey": "${GOOGLE_API_KEY}"
        }
      },
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#00B14F",
          "dark": {
            "backgroundColor": "#1A1A1A"
          }
        }
      ],
      "expo-web-browser",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.travony",
          "enableGooglePay": true
        }
      ],
      "./plugins/withAgoraPickFirst"
    ],
    "experiments": {
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "366f0f57-2f25-4053-a69b-1905365f8013"
      }
    }
  }
}
